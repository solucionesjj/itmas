# Rendered at container start by the nginx image (envsubst over /etc/nginx/templates).
# Variables: API_UPSTREAM, ENTRA_AUTHORITY_ORIGIN (see security-headers.inc.template).
#
# Single public origin: static SPA + reverse proxy to the API for /api, /auth and the OIDC callbacks.
# The API and the database are never published directly.

server_tokens off;

gzip on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;
gzip_min_length 1024;

# Behind the TLS reverse proxy of the host, e.g. Caddy (ADR-0018). The frontend is published only on 127.0.0.1, so
# the proxy is the only peer, seen from the gateway of the edge network. Its X-Forwarded-For (last address) gives
# the real client IP and its X-Forwarded-Proto lets the API build https URLs (OIDC redirect_uri). Without that proxy
# both fall back to the connection itself. Keep the range in sync with EDGE_NETWORK_SUBNET and never publish this
# port beyond loopback.
set_real_ip_from 172.28.10.0/24;
real_ip_header X-Forwarded-For;
map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    # Container health check (does not depend on the API).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API health endpoints are internal (container network only); do not fall back to the SPA.
    location ^~ /health {
        return 404;
    }

    # SQL audit snapshots of the agents (SPEC-0005 RNF-4): the only route with a 16 MB body; the API enforces the same
    # limit on this action only. Same proxying as the rest of the API.
    location = /api/v1/sql-audit-snapshots {
        client_max_body_size 16m;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 60s;
    }

    # Backend-for-Frontend and API. The API sets its own security headers.
    location ~ ^/(api|auth|signin-oidc|signout-callback-oidc)(/|$) {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        # Forwarding headers are rebuilt here (never appended): $remote_addr is the client IP resolved by real_ip above.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
        # OIDC responses carry large (chunked) cookies.
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_read_timeout 60s;
    }

    # Agent packages (SPEC-0002 RF-18, ADR-0010): public (no secrets inside), read-only volume, no listing.
    # Every file is a download; SHA256SUMS is served as text so it can be read in the browser.
    location ^~ /downloads/agent/ {
        alias /usr/share/nginx/downloads/agent/;
        autoindex off;
        disable_symlinks on;
        limit_except GET HEAD { deny all; }
        types { }
        default_type application/octet-stream;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Content-Disposition "attachment" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;

        location ~ /SHA256SUMS$ {
            default_type "text/plain; charset=utf-8";
            include /etc/nginx/conf.d/security-headers.inc;
            add_header Cache-Control "no-cache" always;
            try_files $uri =404;
        }
    }

    # User manual (SPEC-0004, ADR-0013): public static content. Existing files (index.json, *.md) are served as such and
    # always revalidated, so a release is visible at once; anything else under /manual is a SPA route (/manual/<id>).
    location = /manual {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files /index.html =404;
    }

    location ^~ /manual/ {
        limit_except GET HEAD { deny all; }
        types {
            application/json json;
            text/markdown md;
        }
        charset utf-8;
        charset_types application/json text/markdown;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;

        # Content files that do not exist are a 404, never the SPA.
        location ~ \.(?:md|json)$ {
            limit_except GET HEAD { deny all; }
            include /etc/nginx/conf.d/security-headers.inc;
            add_header Cache-Control "no-cache" always;
            try_files $uri =404;
        }
    }

    # Content-hashed bundles produced by the Angular build: cache forever.
    location ~* "-[A-Za-z0-9]{8}\.(?:js|css)$" {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA routes: always revalidate index.html so new releases are picked up.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
