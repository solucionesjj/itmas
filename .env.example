# -----------------------------------------------------------------------------
# Environment template. Copy to .env (or run ./scripts/init-env.sh) and fill in.
# .env is git-ignored: NEVER commit real values. This file contains no secrets.
# -----------------------------------------------------------------------------

# --- General -------------------------------------------------------------------
# Development | Staging | Production. Outside Development the API refuses to start
# without a complete Microsoft Entra ID configuration.
ASPNETCORE_ENVIRONMENT=Development
# Host name(s) the public site is served on (semicolon separated).
APP_ALLOWED_HOSTS=localhost
# Port published on 127.0.0.1 for the web application.
FRONTEND_PORT=8080
# Private subnet of the reverse-proxy network (trusted for X-Forwarded-* headers).
EDGE_NETWORK_SUBNET=172.28.10.0/24
# Gateway of that network, fixed so the host proxy always reaches nginx from the same address. Change it together with the subnet.
EDGE_NETWORK_GATEWAY=172.28.10.1
# Range trusted for X-Forwarded-For / X-Forwarded-Proto (ADR-0018). Empty = the whole edge subnet. In production narrow it to
# EDGE_NETWORK_GATEWAY/32 only after checking on Linux the origin nginx sees (SPEC-0009 CA-22).
EDGE_TRUSTED_PROXY_FROM=

# --- PostgreSQL ------------------------------------------------------------------
# Host and port are internal to Docker (service "postgres", 5432) and need no variable.
POSTGRES_DB=itmas3
# Bootstrap superuser: used only by the postgres container itself.
POSTGRES_SUPERUSER=itmas3_admin
POSTGRES_SUPERUSER_PASSWORD=
# Schema owner, used only by the one-shot migrator container (DDL).
APP_DB_MIGRATOR_USER=itmas3_migrator
APP_DB_MIGRATOR_PASSWORD=
# Runtime role of the API (DML only).
APP_DB_USER=itmas3_app
APP_DB_PASSWORD=

# --- Microsoft Entra ID (app registration of the backend, confidential client) ---
ENTRA_INSTANCE=https://login.microsoftonline.com/
# Origin of the authority, used in the frontend Content-Security-Policy (form-action).
ENTRA_AUTHORITY_ORIGIN=https://login.microsoftonline.com
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Client secret of the backend app registration. Prefer a certificate or managed identity in production.
ENTRA_CLIENT_SECRET=

# --- Authorization (SPEC-0001) ----------------------------------------------------
# Microsoft Entra ID object ids (oid), comma separated, that become Root at sign-in
# ONLY while no active Root exists (initial setup / emergency recovery).
AUTHZ_BOOTSTRAP_ROOT_OIDS=
# Allow B2B guest accounts of the tenant to sign in (default: false).
AUTHZ_ALLOW_GUEST_USERS=false

# --- Device inventory (SPEC-0002, SPEC-0003) --------------------------------------
# Agents enroll with the one-time code of their device, issued from the Inventory screen (ADR-0012).
# Days of inventory history kept per device (the latest inventory is always kept).
INVENTORY_HISTORY_RETENTION_DAYS=90
# Directory with the agent packages served at /downloads/agent/ (built by scripts/build-agent.sh).
AGENT_DOWNLOADS_DIR=./agent/dist

# --- SQL access audit (SPEC-0005) ---------------------------------------------------
# Days the change log, the snapshot receipts and the elements removed from the engines are kept (validations: forever).
SQL_AUDIT_CHANGE_LOG_RETENTION_DAYS=365
# SQL audit snapshots accepted per device and hour (one per configured connection, plus retries; max 50 connections).
SQL_AUDIT_SNAPSHOTS_PER_HOUR=120

# --- Infrastructure agenda (SPEC-0006, SPEC-0008) ---------------------------------
# IANA time zone of the organization. Do not change it once there are activities (they keep the zone they were saved with).
AGENDA_TIME_ZONE=America/Bogota
# Domains the attendees of an activity may belong to, comma separated. Empty: with Outlook on, the domain of the account that sends
# (AGENDA_SMTP_USERNAME, smtp) or of AGENDA_OUTLOOK_MAILBOX (graph); with Outlook off no attendee is accepted, so list the domains
# here if you use attendees.
AGENDA_ALLOWED_ATTENDEE_DOMAINS=
# Public URL of ITMas, for the link in the invitations. Required (absolute https URL) when AGENDA_OUTLOOK_ENABLED=true.
# Without Outlook it is optional: with it the exported .ics links each activity (URL property), without it the .ics has none.
AGENDA_PUBLIC_URL=
# Operations per hour that notify through Outlook (schedule, cancel, sync and changing a scheduled activity), counted for the
# whole API and only after authorization (refused requests do not spend them).
AGENDA_PUBLISH_REQUESTS_PER_HOUR=60
# Publication to Outlook. Off by default: nothing external is called. Do NOT turn it on in production before SPEC-0008 is
# Implemented and the checks of DEVELOPMENT.md section 11 are done.
AGENDA_OUTLOOK_ENABLED=false
# smtp (default): iCalendar invitations sent by SMTP of Microsoft 365 with a username and password (ADR-0023). Host and port are
# fixed in code (smtp.office365.com:587, STARTTLS). graph: the Microsoft Graph adapter (ADR-0016), kept as a way back.
# Switch only without live sends (DEVELOPMENT.md section 11).
AGENDA_OUTLOOK_TRANSPORT=smtp
# smtp: the dedicated mailbox that sends and organizes the meetings. Its UPN must be its primary address. Required with smtp.
AGENDA_SMTP_USERNAME=
# SECRET. Password of that mailbox (ADR-0023: no MFA, accepted exception of the constitution section 3.8 until 2027-05-05).
# Generate it without single quotes in it, write it here directly and never anywhere else, ALWAYS between single quotes
# ('...'): Docker Compose interpolates $ and silently cuts what follows " #". Only in the environment of the api container.
AGENDA_SMTP_PASSWORD=
# graph only: application of Entra ID dedicated to the agenda (NOT the one of the sign-in), limited to the mailbox.
AGENDA_OUTLOOK_TENANT_ID=
AGENDA_OUTLOOK_CLIENT_ID=
# graph only. SECRET. Credential of that application, with a short expiry. Only in the environment of the api container.
AGENDA_OUTLOOK_CLIENT_SECRET=
# graph only: shared mailbox whose calendar receives the activities.
AGENDA_OUTLOOK_MAILBOX=
# Optional. Distribution list of the team, invited as optional when "notify the team" is on (an allowed domain).
AGENDA_OUTLOOK_TEAM_ADDRESS=

# --- Observability (optional) ------------------------------------------------------
# OTLP endpoint (e.g. http://otel-collector:4317). Empty = OpenTelemetry export disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=
