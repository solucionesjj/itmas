# Server
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/itmas

# JWT (separate secrets for access vs. refresh tokens — never reuse one for both)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Default Administrator seed (first boot only; ignored if the username already exists).
# Never hardcode this password — the seeded account must change it on first login.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-on-first-login

# Brute-force protection on POST /auth/login
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SEC=60

# General API-wide rate limit (agent.md §6.8) — applies globally, separate
# from the stricter login-only limit above.
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_SEC=60

# Data retention (agent.md §5.3/§9) — TTL indexes purge documents older than
# this many days from inventories/access_events/audit_log.
INVENTORY_RETENTION_DAYS=180
ACCESS_EVENTS_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365

# IANA timezone the off_hours_access alert rule evaluates habitualHours in.
# Optional — defaults to UTC if unset (agent.md Assumption #6).
HABITUAL_HOURS_TZ=UTC

# AWS Security Group audit extension (docs/adr/0013-...md). Credentials are
# NOT set here — the AWS SDK resolves them via its own default provider chain
# (env vars AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN, or an
# IAM role/instance profile in production). The IAM principal needs only:
# ec2:DescribeRegions, ec2:DescribeSecurityGroups, ec2:DescribeSecurityGroupRules,
# ec2:DescribeNetworkInterfaces, ec2:DescribeInstances, sts:GetCallerIdentity.
#
# Optional comma-separated region override; unset = auto-discover every
# enabled region on the account.
# AWS_SYNC_REGIONS=us-east-1,us-west-2
#
# Daily automated sync time (UTC, 0-23 / 0-59). Defaults to 02:00 UTC.
AWS_SYNC_HOUR=2
AWS_SYNC_MINUTE=0
#
# Retention (days) for the aws_sync_runs operational log (TTL index) — the
# security_group_rules catalog itself is never purged.
AWS_SYNC_RUN_RETENTION_DAYS=90
