[Unit]
Description=ITMas database backup (SPEC-0009)
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
TimeoutStartSec=1h
WorkingDirectory=/opt/itmas3
ExecStart=/opt/itmas3/scripts/backup-db.sh
Environment=XDG_CACHE_HOME=/tmp
# Sandbox (constitution 8.7 d): the script only writes the backup directory. Change ReadWritePaths if BACKUP_DIR is not the default.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/itmas3
