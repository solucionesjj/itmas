#!/bin/sh
# commit-msg hook (SPEC-0007; constitution sections 11.2 and 11.6).
# The first line of the message must start with SPEC-NNNN / ADR-NNNN (comma separated) or `minor: <reason>`.
# Messages generated by git (merge, revert, fixup, squash) pass through.
# The message is untrusted input: it is only matched against a pattern, never evaluated or interpolated.
set -eu

# An inherited GREP_OPTIONS (for example --invert-match) must not change the verdict.
unset GREP_OPTIONS GREP_COLOR GREP_COLORS

msg_file=${1:?"commit message file is required"}

# First line that is not blank and not a comment, without CR and trailing blanks.
first_line=$(LC_ALL=C grep -v '^#' "$msg_file" | LC_ALL=C tr -d '\r' |
  LC_ALL=C sed -n '/[^[:space:]]/{s/[[:space:]]*$//;p;q;}')

case $first_line in
  "Merge "* | 'Revert "'* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

pattern='^(((SPEC|ADR)-[0-9]{4})(, (SPEC|ADR)-[0-9]{4})*|minor): .+'
if printf '%s\n' "$first_line" | LC_ALL=C grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Mensaje de commit rechazado (SPEC-0007, constitución §11.2). El primer renglón debe empezar por un ID de spec o ADR:
  SPEC-0007: texto del cambio
  SPEC-0000, SPEC-0001: texto del cambio
Correcciones menores sin spec (§11.6), con el motivo:
  minor: texto del cambio
EOF
exit 1
